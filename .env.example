# TGA SANDBOX ENVIRONMENT REFERENCE
# Never commit real secrets. Vercel values are build-time browser configuration only.

# -----------------------------------------------------------------------------
# VERCEL FRONTEND
# -----------------------------------------------------------------------------
# Use "demo" for the standalone browser-only POC.
# Change to "api" only after the Render backend is live.
TGA_FRONTEND_DATA_MODE=demo

# Required when TGA_FRONTEND_DATA_MODE=api.
# Example: https://tga-member-api-sandbox.onrender.com
VITE_API_BASE_URL=

# Keep the stakeholder sandbox visibly in demo mode and out of search engines.
DEMO_MODE=true
PUBLIC_INDEX=false

# Optional canonical/public site URL. Safe to leave blank for the private sandbox.
# Example: https://your-project.vercel.app
SITE_URL=

# -----------------------------------------------------------------------------
# RENDER BACKEND
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Sandbox
TGA_DATA_MODE=Demo
TGA_PAYMENT_MODE=Mock
TGA_EMAIL_MODE=Console
TGA_SMS_MODE=Console

# Exact Vercel HTTPS origin, with NO trailing slash.
# Example: https://your-project.vercel.app
AllowedOrigins__0=

# render.yaml generates Jwt__Key automatically when deployed as a Blueprint.
# If creating the Render service manually, set a fresh random 32+ byte secret.
Jwt__Key=

# Sandbox access tokens are deliberately long enough for a client demo even if
# a browser blocks the cross-site refresh cookie between vercel.app/onrender.com.
# Production should use a shorter reviewed value.
Jwt__AccessTokenMinutes=120

# Explicit sandbox paths. Render Free storage is ephemeral.
ConnectionStrings__Demo=Data Source=data/tga.db
Storage__Path=data/documents

# Optional overrides for the public fictional demo accounts documented in
# docs/DEMO_ACCOUNTS.md. Do not set blank overrides in Render.
DemoAdmin__Email=admin@tga.co.za
DemoAdmin__Password=
DemoMember__Password=

# Production-only future configuration, NOT required for the sandbox:
# TGA_DATA_MODE=SqlServer
# ConnectionStrings__SqlServer=Server=YOUR_SERVER;Database=Tga;Encrypt=True;...
