# Frontend build settings. Defaults to the standalone browser POC.
TGA_FRONTEND_DATA_MODE=demo
VITE_API_BASE_URL=
DEMO_MODE=true
PUBLIC_INDEX=false
SITE_URL=

# Backend environment settings (set in the shell or hosting dashboard).
ASPNETCORE_ENVIRONMENT=Development
TGA_DATA_MODE=Demo
TGA_PAYMENT_MODE=Mock
TGA_EMAIL_MODE=Console
TGA_SMS_MODE=Console
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://127.0.0.1:5173
# Required in Sandbox: generate a fresh random value with at least 32 bytes.
Jwt__Key=
# Optional overrides for the explicitly public demo passwords in docs/DEMO_ACCOUNTS.md.
DemoAdmin__Email=admin@tga.co.za
DemoAdmin__Password=
DemoMember__Password=
